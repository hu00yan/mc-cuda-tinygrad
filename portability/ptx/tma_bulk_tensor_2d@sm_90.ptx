.version 8.6
.target sm_90
.address_size 64
.extern .shared .align 128 .b8 sm[];
.extern .shared .align 8 .b8 mbar[];
.visible .entry k() {

  .reg .b32 %r<16>;
  .reg .b64 %rd<16>;
  mov.b64 %rd1, 0;
  mov.b64 %rd2, 0;
  mov.b32 %r1, 0;
  mov.b32 %r3, 0;
  mov.b32 %r4, 0;
  cp.async.bulk.tensor.2d.shared::cta.global.mbarrier::complete_tx::bytes.L2::cache_hint
    [%r1], [%rd1, {%r3, %r4}], [%r2], %rd2;
  cp.async.bulk.commit_group;
  cp.async.bulk.wait_group 0;
  ret;
}
