.version 7.8
.target sm_80
.address_size 64
.extern .shared .align 128 .b8 sm[];
.extern .shared .align 8 .b8 mbar[];
.visible .entry k() {

  .reg .b32 %r<16>;
  .reg .b64 %rd<16>;
  mov.b64 %rd1, 0;
  mov.b32 %r1, 0;
  cp.async.cg.shared.global [%r1], [%rd1], 16;
  cp.async.commit_group;
  cp.async.wait_group 0;
  ret;
}
