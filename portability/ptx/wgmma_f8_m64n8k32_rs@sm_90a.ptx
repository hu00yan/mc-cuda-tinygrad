.version 8.3
.target sm_90a
.address_size 64
.extern .shared .align 128 .b8 sm[];
.extern .shared .align 8 .b8 mbar[];
.visible .entry k() {

  .reg .b32 %r<16>;
  .reg .b64 %rd<16>;
  .reg .pred %p<4>;
  mov.b32 %r1, 0;
  mov.b64 %rd1, 0;
  setp.ne.b32 %p1, %r1, 0;
  wgmma.fence.sync.aligned;
  wgmma.mma_async.sync.aligned.m64n8k32.f16.e4m3.e4m3
    {%r1, %r2}, {%r3, %r4, %r5, %r6}, %rd1, %p1, 1, 1;
  wgmma.wait_group.sync.aligned 0;
}
