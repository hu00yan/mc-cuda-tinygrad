.version 8.3
.target sm_90
.address_size 64
.extern .shared .align 128 .b8 sm[];
.extern .shared .align 8 .b8 mbar[];
.visible .entry k() {

  .reg .b32 %r<16>;
  .reg .b64 %rd<16>;
  mov.b64 %rd1, 0;
  mov.b32 %r1, 0;
  mov.b32 %r2, 256;
  cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes
    [%r1], [%rd1], %r2, [%r1];
  cp.async.bulk.commit_group;
  cp.async.bulk.wait_group 0;
  ret;
}
