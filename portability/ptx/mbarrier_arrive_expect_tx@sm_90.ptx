.version 8.3
.target sm_90
.address_size 64
.extern .shared .align 128 .b8 sm[];
.extern .shared .align 8 .b8 mbar[];
.visible .entry k() {

  .reg .b32 %r<16>;
  .reg .pred %p<8>;
  mov.b32 %r1, 0;
  mov.b32 %r2, 1;
  mbarrier.init.shared.b64 [%r1], %r2;
  mbarrier.arrive.expect_tx.shared.b64 _, [%r1], 128;
  mbarrier.try_wait.parity.shared.b64 %p1, [%r1], 0;
  ret;
}
