  .reg .b32 %r<16>;
  .reg .b64 %rd<16>;
  .reg .pred %p<4>;
  mov.b32 %r1, 0;
  mov.b64 %rd1, 0;
  mov.b64 %rd2, 0;
  mov.b32 %r3, 0;
