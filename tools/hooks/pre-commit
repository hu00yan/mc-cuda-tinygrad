#!/bin/sh
# Rules 2b / 7 / 20 / 20b / 21 / 22 as gates.
#
# check_audit.sh caught 7 unaudited rules today, every time AFTER the commit already
# existed — an audit that runs afterwards is a report, not a gate. check_tables.py was
# added the same night for rules 20/20b/21 after Cindy noted a P2 rule "still works
# tomorrow only because we did not make it P1 tonight".
#
# Each prints what it does NOT check (rule 22): presence checks pass liars, and a green
# line that implies more than it checks manufactures the confidence it was built to kill.
set -e
bash tools/check_audit.sh
.venv/bin/python tools/check_tables.py --self-test
.venv/bin/python tools/check_tables.py tools/REPORTING-RULES.md
