# CUDA toolchain for compile-only analysis. No GPU, no driver, no CUDA runtime.
#
# Why this shape: the multi-GB nvidia/cuda image timed out at 10 min, and the
# `nvidia-cuda-nvcc-cu12` pip wheel turned out to ship *only* ptxas (no nvcc,
# no cuobjdump, no nvdisasm). NVIDIA's conda channel also does not publish a
# real nvcc binary package (cuda-nvcc -> cuda-nvcc_linux-64 are both
# metapackages that only ship conda activate scripts). So we assemble the tool
# set from the small pieces that DO exist:
#
#   ptxas      <- pip wheel nvidia-cuda-nvcc-cu12   (the assembler; 12.9.86,
#                  which is the version that supports sm_90a and sm_100a)
#   cuobjdump  <- conda  nvidia/label/cuda-12.9.1   (cubin -> SASS)
#   nvdisasm   <- conda  nvidia/label/cuda-12.9.1   (cubin -> SASS)
#   clang-18   <- apt                              (CUDA C++ -> PTX frontend;
#                  we do NOT use nvcc, which is unavailable here -- see
#                  RESULTS.md "toolchain substitutions")
#   headers    <- pip wheels cuda_runtime / cuda_cccl / cuda_nvcc
#
# Everything is x86-64 and runs under OrbStack emulation on the Mac host.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      python3 python3-pip python3-venv \
      curl ca-certificates unzip zstd bzip2 \
      git make gnupg lsb-release software-properties-common && \
    rm -rf /var/lib/apt/lists/*

# clang 20 from apt.llvm.org. Ubuntu 24.04 ships clang-18, which tops out at
# CUDA 12.3 / sm_90a -- it cannot *emit* .target sm_100a PTX, so Blackwell
# targets (tcgen05, block-scaled) are unreachable with it. clang 20 knows
# sm_100a and CUDA 12.8+.
RUN curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/llvm.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/$(lsb_release -cs)/ llvm-toolchain-$(lsb_release -cs)-20 main" \
      > /etc/apt/sources.list.d/llvm20.list && \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      clang-20 llvm-20 && \
    rm -rf /var/lib/apt/lists/* && \
    clang-20 --version | head -1

# --- ptxas + CUDA headers -------------------------------------------------
RUN python3 -m venv /opt/py && \
    /opt/py/bin/pip install -q --no-cache-dir \
      nvidia-cuda-nvcc-cu12 \
      nvidia-cuda-runtime-cu12 \
      nvidia-cuda-cccl-cu12 && \
    mkdir -p /opt/cuda/bin /opt/cuda/include /opt/cuda/nvvm/libdevice && \
    cp -a /opt/py/lib/python3*/site-packages/nvidia/cuda_nvcc/bin/. /opt/cuda/bin/ && \
    for d in cuda_runtime cuda_cccl cuda_nvcc; do \
      src=$(echo /opt/py/lib/python3*/site-packages/nvidia/$d/include); \
      [ -d "$src" ] && cp -a "$src"/. /opt/cuda/include/ || true; \
    done && \
    find /opt/py -name 'libdevice*.bc' -exec cp -a {} /opt/cuda/nvvm/libdevice/ \; ; \
    ls /opt/cuda/bin && /opt/cuda/bin/ptxas --version | tail -3

# --- cuobjdump / nvdisasm from NVIDIA's conda channel ---------------------
COPY fetch_conda_pkg.sh /usr/local/bin/fetch_conda_pkg.sh
RUN chmod +x /usr/local/bin/fetch_conda_pkg.sh && \
    B=https://conda.anaconda.org/nvidia/label/cuda-12.9.1/linux-64 && \
    for p in cuda-cuobjdump-12.9.82-1.conda cuda-nvdisasm-12.9.88-1.conda cuda-nvprune-12.9.82-1.conda; do \
      fetch_conda_pkg.sh "$B/$p" /opt/cudatools; \
    done && \
    cp -a /opt/cudatools/bin/. /opt/cuda/bin/ && \
    ls -la /opt/cuda/bin

ENV CUDA_HOME=/opt/cuda \
    CUDA_PATH=/opt/cuda \
    CLANG_CUDA=clang-20 \
    PATH=/opt/cuda/bin:$PATH

WORKDIR /work

# report what we actually have, so a log can prove it
RUN echo "=== toolchain ===" && \
    /opt/cuda/bin/ptxas --version | tail -2 && \
    (clang-20 --version | head -1) && \
    (cuobjdump --version | head -1 || true) && \
    (nvdisasm --version | head -1 || true) && \
    echo "=== arch support in ptxas ===" && \
    /opt/cuda/bin/ptxas --help | grep -oE "sm_[0-9]+[af]?" | sort -u | tr '\n' ' ' && \
    echo && echo "=== arch support in clang-20 (device compile) ===" && \
    echo 'int main(){return 0;}' > /tmp/x.cu && \
    for a in sm_75 sm_80 sm_89 sm_90a sm_100a; do \
      if clang-20 -x cuda --cuda-device-only -S --cuda-gpu-arch=$a --cuda-path=/opt/cuda \
           -o /dev/null /tmp/x.cu 2>/dev/null; then echo "  $a OK"; else echo "  $a UNSUPPORTED"; fi; \
    done
