+	@for s in $(SEEDS) $(BENCH_SEEDS); do \
+	   [ -f cells_$$s.bin ] || { echo "make: cells_$$s.bin missing after the loop" >&2; exit 1; }; \
+	 done
+	@echo "cells: $$(ls cells_*.bin | wc -l | tr -d ' ') fixtures, covering seeds $(SEEDS) and 0..$$(( $(NENVS) - 1 )) for B=$(NENVS)"
 
