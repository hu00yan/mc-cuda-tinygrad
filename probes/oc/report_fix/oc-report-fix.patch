+# rows, and the `cells` recipe below must produce 0..NENVS-1 for them: the
+# report loads cells_0.bin .. cells_$(shell expr $(NENVS) - 1).bin with no
+# discovery and no fallback. One number, passed to the report as OC_B, so the
+# recipe and the consumer cannot drift apart again.
+NENVS  ?= 32
 CORE  := ../../netherite/blaze/core
 PY    := ../../.venv/bin/python
 
+comma := ,
+empty  :=
+space  := $(empty) $(empty)
+SEEDS_CSV   := $(subst $(space),$(comma),$(SEEDS))
+BENCH_SEEDS := $(shell seq 0 $(shell expr $(NENVS) - 1))
+
 ref_oc: ref_oc.c
 	clang -O2 -ffp-contract=off -I$(CORE) ref_oc.c -o ref_oc -lm
 
+# Every seed anything downstream reads: the contiguous 0..NENVS-1 run the
+# batched benchmark loads, plus $(SEEDS) for the correctness section (12345
+# sits outside the contiguous run). At NENVS=32 that is 33 files, 87.6 MB,
+# all gitignored and regenerable in ~2s. The old recipe emitted 9, which is
+# why `make report` could never finish -- see notes/11-local-suite-integrity.md.
+# The second loop is the point: the recipe proves it produced what the report
+# needs, instead of the report discovering it 150 s later inside np.fromfile.
