-	./ref_oc --out ref.bin --seeds 0,3,12345 --poses 6
+	./ref_oc --out ref.bin --seeds $(SEEDS_CSV) --poses 6
 
 report: ref.bin cells
-	$(PY) oc_report.py
+	OC_B=$(NENVS) $(PY) oc_report.py
 
 check: ref.bin cells
-	$(PY) run_oc.py --seeds 0,3,12345 --check-steps
+	OC_B=$(NENVS) $(PY) run_oc.py --seeds $(SEEDS_CSV) --check-steps
 
 clean:
 	rm -f ref_oc ref.bin cells_*.bin

