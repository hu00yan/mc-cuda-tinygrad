# archlab/nvcc:12.9 -- offline CUDA toolchain, no GPU, no driver.
#
# Purpose: compile and disassemble CUDA on a machine that has neither a GPU nor
# a host nvcc. Used by tools/archlab/inspect_ptx.py (see notes/05-archlab.md).
#
# The `-devel` image already carries the full toolkit; the RUN steps below make
# the required tools an explicit, build-time-enforced contract rather than an
# assumption about the upstream image's contents.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# python3 is not in the -devel base image; the rest are, but a missing one is a
# build failure, not a silent runtime surprise.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Hard requirement: every tool the analysis depends on must be on PATH and must
# actually run. `cuobjdump -sass` shells out to `nvdisasm`, so its presence is
# not optional.
RUN for t in nvcc ptxas cuobjdump nvdisasm python3; do \
        command -v "$t" >/dev/null || { echo "MISSING: $t" >&2; exit 1; }; \
    done \
 && nvcc --version \
 && ptxas --version \
 && python3 --version

WORKDIR /work
CMD ["/bin/bash"]
