,{"stream_name":"stdout","time":1158.799776178,"data":"numpy     D2          64      12      2,041     0.8%         [2052, 2057, 2041]  C by 1.75x\n"}
,{"stream_name":"stdout","time":1158.799778646,"data":"\n"}
,{"stream_name":"stdout","time":1158.799780903,"data":"  spelling arange  kernel_us: C 839 (spread 2.9%) vs D2 1,503 (spread 2.7%)  -\u003e  C, 1.79x\n"}
,{"stream_name":"stdout","time":1158.799783513,"data":"  spelling numpy   kernel_us: C 1,169 (spread 3.7%) vs D2 2,041 (spread 0.8%)  -\u003e  C, 1.75x\n"}
