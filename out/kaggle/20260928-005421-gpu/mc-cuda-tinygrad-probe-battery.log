,{"stream_name":"stdout","time":284.601584987,"data":"        *(buf0+15) = ((*(buf0+15))+(exp2((((val6.x-val10.x)+alu16)*1.4426950216293335f))*val14.x*val18.x)+(exp2((((val6.y-val10.y)+alu16)*1.4426950216293335f)\n"}
,{"stream_name":"stdout","time":284.602697767,"data":"    \n"}
,{"stream_name":"stdout","time":284.603736636,"data":"      ^ note what is NOT here: no tensor-core MMA (`tl.dot` equivalent),\n"}
,{"stream_name":"stdout","time":284.604757837,"data":"        no `exp2`, and the decay is a [C,C,K] tensor that had to be\n"}
,{"stream_name":"stdout","time":284.605836958,"data":"        materialised before the reduction over K could happen.\n"}
,{"stream_name":"stdout","time":284.606864148,"data":"    \n"}
,{"stream_name":"stdout","time":284.607937933,"data":"    ==============================================================================\n"}
,{"stream_name":"stdout","time":284.608961159,"data":"    SIDE BY SIDE\n"}
,{"stream_name":"stdout","time":284.609981724,"data":"    ==============================================================================\n"}
,{"stream_name":"stdout","time":284.611060664,"data":"      step       TRITON (fla, hand-written)                           TINYGRAD\n"}
,{"stream_name":"stdout","time":284.612096412,"data":"      --------------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":284.61318667,"data":"      grid       grid = (NT, NC, B * HV)            # NT=T/64, NC=64/ \n"}
,{"stream_name":"stdout","time":284.614228438,"data":"      constexpr  BT = 64;  BC = 16;  NC = cdiv(BT, BC) = 4            \n"}
,{"stream_name":"stdout","time":284.615368139,"data":"      load       b_k0  = tl.load(p_k0, mask=m_ck0).to(tl.float32)     \n"}
,{"stream_name":"stdout","time":284.616577545,"data":"      load       b_g0  = tl.load(p_g0, mask=m_ck0).to(tl.float32)     \n"}
,{"stream_name":"stdout","time":284.617617071,"data":"      load       b_gn1 = tl.load(g + ... + o_k, mask=m_k).to(tl.float \n"}
,{"stream_name":"stdout","time":284.618755533,"data":"      decay      b_gqn = tl.where(m_tc1[:, None], exp2(b_g1 - b_gn1[N \n"}
,{"stream_name":"stdout","time":284.619848254,"data":"      decay      b_kgt = tl.trans(b_k0 * exp2(b_gn1[None, :] - b_g0)) \n"}
,{"stream_name":"stdout","time":284.620935529,"data":"      mma        b_Akk10 = tl.dot(b_k1 * b_gqn, b_kgt, b_Akk10)       \n"}
,{"stream_name":"stdout","time":284.62198023,"data":"      store      tl.store(p_Akk10, b_Akk10.to(dtype), mask=m_c1)      \n"}
,{"stream_name":"stdout","time":284.623037317,"data":"                 the [BC, BC] score block never leaves registers; the only\n"}
,{"stream_name":"stdout","time":284.624101521,"data":"                 extra buffer is Akkd = empty(B, T, HV, BC) -- [T,16], not [T,T]\n"}
,{"stream_name":"stdout","time":284.625306042,"data":"    \n"}
,{"stream_name":"stdout","time":284.626467548,"data":"      TinyGrad's equivalent of the three Triton lines is:\n"}
,{"stream_name":"stdout","time":284.627575966,"data":"          decay = (gcum[:,:,:, :,None] - gcum[:,:,:,None,:]).exp()   -\u003e [C,C,K]\n"}
,{"stream_name":"stdout","time":284.628664247,"data":"          gram  = (decay * k[:,:,:,:,None] * k[:,:,:,None,:]).sum(-1) -\u003e [C,C]\n"}
,{"stream_name":"stdout","time":284.629720563,"data":"      Same result, but the intermediate is C x C x K instead of BC x K,\n"}
,{"stream_name":"stdout","time":284.630723964,"data":"      and the contraction is a generic sum() rather than a tensor-core MMA.\n"}
,{"stream_name":"stdout","time":284.63178687,"data":"  [ok     ] codegen_diff           2.3s  generated code vs hand-written Triton\n"}
,{"stream_name":"stdout","time":332.784389567,"data":"\n"}
