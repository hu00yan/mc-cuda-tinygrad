,{"stream_name":"stdout","time":1449.878409953,"data":"  [battery  988.7s]   batch   1024  clean     3.012 ms  faithful    10.442 ms  faithful/clean  3.466  clean/ref   10.43  faithful/ref   36.16  same obs True   (DEVICE ms)\n"}
,{"stream_name":"stdout","time":1449.87930317,"data":"  [battery  988.7s]   batch   2048  clean     5.642 ms  faithful    20.715 ms  faithful/clean  3.672  clean/ref   10.04  faithful/ref   36.87  same obs True   (DEVICE ms)\n"}
